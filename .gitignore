# 超大目录（必须忽略）
dataset/
pretrained/

# output_dir：只保留日志目录
# 第1步：忽略顶层文件，但允许进入子目录（关键！否则 git 不遍历）
output_dir/*
!output_dir/*/
# 第2步：忽略子目录内的所有内容
output_dir/*/**
# 第3步：捞回日志目录和文件
!output_dir/eval_logs/
!output_dir/eval_logs/**
!output_dir/**/log_*/
!output_dir/**/log_*/**

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd
*.tmp

# 日志：全局忽略 .log，但保留 output_dir 下的
*.log
!output_dir/**/*.log

# 系统 & IDE
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# 模型权重文件
*.pth
*.pt
